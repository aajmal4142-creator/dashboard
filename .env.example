# =============================================================================
# ClearESG — environment variables
# Copy to `.env` / `.env.local` and fill in. Never commit secrets.
# =============================================================================

# --- App ---
# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Payload CMS ---
# Random 32+ char secret used to sign Payload JWTs
PAYLOAD_SECRET=change-me-to-a-long-random-string
# MongoDB Atlas connection string (never use free M0 for real data)
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/clearesg

# --- Clerk (Phase 2) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- Resend (Phase 2+) ---
RESEND_API_KEY=
EMAIL_FROM=ClearESG <noreply@clearesg.com>
# Inbound receiving domain for email CSV import (import+TOKEN@domain)
EMAIL_IMPORT_INBOUND_DOMAIN=inbound.clearesg.com
# Optional override for scheduled-report unsubscribe HMAC (falls back to PAYLOAD_SECRET)
REPORT_UNSUBSCRIBE_SECRET=

# --- Stripe (Phase 12) ---
# Create Price IDs in Stripe Dashboard; do not invent IDs here.
# Display list prices (USD): Pro $199/mo · Professional $399/mo · Consultant $799/mo
# Annual (~17% off): Pro $1,990/yr · Professional $3,990/yr · Consultant $7,990/yr
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_CONSULTANT=

# --- Billing provider / Razorpay INR (Y05 — open decision §11) ---
# Which processor BillingClient and checkout routes treat as active. Stripe stays
# the default; do not flip to razorpay without an explicit go-ahead on §11.
BILLING_PROVIDER=stripe
# Display / quoting currency. Product list prices are USD. INR implies the Razorpay
# path is expected to be live — still gated behind RAZORPAY_KEY_ID/SECRET +
# CLEARESG_WS0_SIGNED_OFF regardless of this value.
BILLING_CURRENCY=USD
# Razorpay API credentials — leave blank until §11 (INR/Razorpay) is signed off.
# Never assume production credentials; this repo ships gated scaffolding only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Upstash Redis (Phase 7/14 rate limits) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- File storage (Phase 6 Evidence Vault) ---
# UploadThing OR S3-compatible — pick one path in Phase 6
UPLOADTHING_TOKEN=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Slack (Sprint 4 / F13) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# --- EcoVadis Integration (SM-001) ---
ECOVADIS_CLIENT_ID=
ECOVADIS_CLIENT_SECRET=
ECOVADIS_REDIRECT_URI=http://localhost:3000/api/app/integrations/ecovadis/callback

# --- Observability (Phase 14) ---
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- DPDP / India privacy (Y06 — open decision §11) ---
# Hosting region / Atlas selection is an open decision. Leave blank until ops confirms.
CLEARESG_ATLAS_REGION=
# Retention purge cron (/api/cron/privacy/retention-purge) is dry-run only until this is "1".
# Never enable in production without a written ops decision — see docs/LAUNCH_DECISIONS.md.
CLEARESG_RETENTION_PURGE_LIVE=
